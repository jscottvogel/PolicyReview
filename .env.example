# AWS Configuration
AWS_REGION=us-east-1

# If using LocalStack, uncomment the following:
# AWS_ENDPOINT=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Application Config
PORT=3000
NODE_ENV=development

# Data Tables/Buckets (Must exist in your AWS/LocalStack account)
TABLE_DOCUMENTS=Documents
TABLE_FINDINGS=Findings
BUCKET_DATA=policy-review-data
